    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.1.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
