# Server-only. Never prefix your Gemini API key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional scalable global OSM PostGIS backend. Never expose this to browsers.
# Leave unset to keep free regional snapshot search working.
# Requires an adequately sized, durable PostgreSQL+PostGIS database.
PLACES_DATABASE_URL=
